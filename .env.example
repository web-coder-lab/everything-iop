NODE_ENV=production
PORT=3001
CLIENT_DIST=dist
TRUST_PROXY=true
# Leave empty for same-origin deployment; otherwise use a comma-separated trusted origin list.
CORS_ORIGIN=https://your-domain.example
MAX_STREAM_STORAGE_HOURS=6

# Private content/data API. Keep these server-side only.
PRIVATE_API_BASE_URL=
PRIVATE_API_KEY=
PRIVATE_API_TIMEOUT_MS=15000
PRIVATE_API_UPLOAD_MAX_MB=100

# Firebase: payment/financial data and explicitly assigned storage only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Payment gateway: add only after final project verification.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_TIMEOUT_MS=15000
PAYMENT_WEBHOOK_SECRET=
