{
  "name": "everything",
  "private": true,
  "version": "3.0.0-integrated",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --port=3000 --host=0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run server:build && vite build",
    "build:client": "vite build",
    "start": "node dist-server/index.js",
    "server:build": "tsc -p server/tsconfig.json",
    "server:check": "tsc -p server/tsconfig.json --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist dist-server",
    "verify": "npm run server:check && tsc --noEmit && npm run build",
    "verify:connection": "node scripts/verify-integrated-server.mjs",
    "static:check": "node scripts/static-integration-check.mjs",
    "handoff:check": "node scripts/handoff-check.mjs",
    "audit:buttons": "node scripts/button-audit.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io-client": "^4.8.3",
    "vite": "^8.3.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "concurrently": "^9.2.1"
  }
}
